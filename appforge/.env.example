# ── AppForge environment configuration ─────────────────────────────
# Copy to .env (API reads apps/api/.env or process env).

# Runtime
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173

# Storage driver: "postgres" for production, "memory" for local preview
# without a database (auto-seeded with demo data).
STORAGE_DRIVER=memory

# PostgreSQL (required when STORAGE_DRIVER=postgres)
DATABASE_URL=postgres://appforge:appforge@localhost:5432/appforge

# Auth
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=30d

# AI generation provider: "gemini" or "mock"
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Email adapter: "console" logs emails, "smtp" reserved for production
EMAIL_DRIVER=console
EMAIL_FROM=no-reply@appforge.local

# File storage adapter: "local" or "s3" (placeholder)
FILE_STORAGE_DRIVER=local
FILE_STORAGE_LOCAL_DIR=./storage/uploads
FILE_MAX_UPLOAD_MB=10

# CORS: comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
